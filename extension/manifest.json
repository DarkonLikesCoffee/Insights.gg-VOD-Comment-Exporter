{
  "manifest_version": 3,
  "name": "Insights.gg VOD Comment Exporter",
  "version": "3.0.1",
  "description": "Export Insights.gg VOD comments and replies in multiple formats.",
  "permissions": [
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://insights.gg/*",
    "https://*.insights.gg/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Export VOD Comments",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://insights.gg/*",
        "https://*.insights.gg/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}